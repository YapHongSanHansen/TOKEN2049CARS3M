# CARSEM backend configuration. Copy to .env (both carsem-api and agent read it).

# ---------------------------------------------------------------------------
# Chain mode
#   simulated  (default) the full loop runs on an in-process signed ledger.
#              x402 headers, offers, signing and facilitator verify/settle are
#              exercised for real; only the chain is simulated. No keys needed.
#   preprod    real Cardano preprod: Blockfrost + the Java cardano-x402-facilitator.
# ---------------------------------------------------------------------------
CHAIN_MODE=simulated

# ---- carsem-api ------------------------------------------------------------
PORT=4021
PUBLIC_URL=http://localhost:4021
DB_PATH=./data/carsem.db

# Masumi dispenser tUSDM (https://dispenser.masumi.network). The SDK's other
# preprod tUSDM is e675b46e4d2242c991a8932a99db3044e80515ae14b4c4ccf6b3f4c9.0014df10745553444d
USDM_ASSET=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde.0014df10745553444d

SIGNAL_PRICE_USDM=5
LOAN_FEE_BPS=200
LOAN_MAX_USDM=10
# Short on purpose so the default path can be shown live.
LOAN_DEADLINE_SECONDS=300
DEFAULT_CHECK_INTERVAL_MS=10000
# Confirmation depth the paywall asks the facilitator for (0 = block inclusion).
L1_CONFIRMATIONS=0

# 32-byte hex key that encrypts redacted bundles at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUNDLE_KEY=

# DEX simulator (Minswap stand-in): auto | win | loss
DEX_SIM_OUTCOME=auto
ADA_PRICE_USDM=0.45

# ---- preprod only ----------------------------------------------------------
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
# The Java facilitator (npm run facilitator:up) listens here.
FACILITATOR_URL=http://localhost:4022
# Lender + seller wallet (24 words). Holds tUSDM for loans, receives payments.
TREASURY_MNEMONIC=
# Optional wallet that pays simulated DEX profits; defaults to the treasury.
MARKET_MAKER_MNEMONIC=
# Buyer wallet for `npm run enterprise:buy` on preprod (needs tUSDM).
ENTERPRISE_MNEMONIC=

# ---- agent -----------------------------------------------------------------
CARSEM_API_URL=http://localhost:4021
CARSEM_AGENT_ID=agent-demo
CARSEM_AGENT_KEY=dev-agent-key
# preprod: the agent's own wallet (leave it with ~0.05 tUSDM for the demo).
AGENT_MNEMONIC=
# simulated: wallet seeds (any string)
SIM_AGENT_SEED=carsem-agent
SIM_TREASURY_SEED=carsem-treasury
SIM_MARKET_MAKER_SEED=carsem-dex-pool
# Spend cap per x402 payment, in tUSDM.
AGENT_MAX_PAYMENT_USDM=60
AGENT_TRADE_SIZE_ADA=400
AGENT_PORT=4031

# Optional: Claude drives the agent's tool loop. Without a key, a scripted
# planner runs the same policy deterministically.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
