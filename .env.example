# CARSEM configuration (non-secret). Copy to .env.
# Secrets (keys, mnemonics) go in .env.local, which wins over this file and is gitignored.

# simulated: everything runs locally on a signed ledger, no keys needed.
# preprod:   real Cardano preprod (Blockfrost + the Java x402 facilitator).
CHAIN_MODE=simulated

# ---- carsem-api (the platform) ---------------------------------------------
PORT=4021
PUBLIC_URL=http://localhost:4021
FRONTEND_URL=http://localhost:5173
DB_PATH=./data/carsem.db

# Masumi dispenser tUSDM (https://dispenser.masumi.network).
USDM_ASSET=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde.0014df10745553444d

# Data prices (USDM). Signals match the drawing's 5 USDM paywall.
PRICE_SIGNAL_USDM=5
PRICE_FLIGHT_USDM=1
PRICE_HOTEL_USDM=1
PRICE_PRODUCT_USDM=1
# After a default: anyone verified can access the published chats for this fee.
PUBLIC_ACCESS_PRICE_USDM=1
# Proceeds beyond the defaulted debt go to: platform (as drawn) | user
DEFAULT_SURPLUS_TO=platform

LOAN_FEE_BPS=200
LOAN_MAX_USDM=10
# Short on purpose so the default path can be shown live.
LOAN_DEADLINE_SECONDS=300
DEFAULT_CHECK_INTERVAL_MS=10000
# Fewest past messages the user must pick to pledge for one loan.
MIN_PLEDGE_ITEMS=3
# What each new agent wallet starts with (the 0.05 USDM that cannot pay a 5 USDM paywall).
STARTER_USDM=0.05
# STARTER_ADA defaults to 100 (simulated) / 5 (preprod).
L1_CONFIRMATIONS=0

# DEX simulator (Minswap stand-in): auto | win | loss
DEX_SIM_OUTCOME=auto
ADA_PRICE_USDM=0.45

# ---- agent gateway (MCP + curl for Hermes, Claude Code, ChatGPT, Claude) ----
GATEWAY_PORT=4031
GATEWAY_URL=http://localhost:4031
GATEWAY_PUBLIC_URL=http://localhost:4031
GATEWAY_DB_PATH=./data/gateway.db
CARSEM_API_URL=http://localhost:4021
AGENT_MAX_PAYMENT_USDM=60
AGENT_TRADE_SIZE_ADA=400

# ---- preprod only -----------------------------------------------------------
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
FACILITATOR_URL=http://localhost:4022
